{% assign current_product = section.settings.product | default: product %}

<section class="hero-product" aria-label="Présentation produit">

  <!-- Média gauche -->
  <div class="hero-product__media">
    {% if section.settings.hero_video != blank %}
      <video
        autoplay muted loop playsinline
        poster="{{ section.settings.hero_image | img_url: '1200x' }}"
        aria-hidden="true"
      >
        <source src="{{ section.settings.hero_video }}" type="video/mp4">
      </video>
    {% elsif section.settings.hero_image %}
      <img
        src="{{ section.settings.hero_image | img_url: '1200x' }}"
        srcset="
          {{ section.settings.hero_image | img_url: '375x' }} 375w,
          {{ section.settings.hero_image | img_url: '768x' }} 768w,
          {{ section.settings.hero_image | img_url: '1200x' }} 1200w
        "
        sizes="(max-width: 900px) 100vw, 50vw"
        alt="{{ section.settings.hero_image.alt | default: current_product.title }}"
        width="1200"
        height="1500"
        loading="eager"
        fetchpriority="high"
      >
    {% elsif current_product.featured_image %}
      <img
        src="{{ current_product.featured_image | img_url: '1200x' }}"
        srcset="
          {{ current_product.featured_image | img_url: '375x' }} 375w,
          {{ current_product.featured_image | img_url: '768x' }} 768w,
          {{ current_product.featured_image | img_url: '1200x' }} 1200w
        "
        sizes="(max-width: 900px) 100vw, 50vw"
        alt="{{ current_product.featured_image.alt | default: current_product.title }}"
        width="1200"
        height="1500"
        loading="eager"
        fetchpriority="high"
      >
    {% else %}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#2A1A2A,#1A1A1A);display:flex;align-items:center;justify-content:center;font-size:80px;">
        💄
      </div>
    {% endif %}
  </div>

  <!-- Content droite -->
  <div class="hero-product__content">

    <!-- Badge lancement -->
    <div class="hero-product__badge" data-reveal>
      <span class="pulse-dot" aria-hidden="true"></span>
      <span>{{ section.settings.badge_text | default: 'Offre Lancement — Stock Limité' }}</span>
    </div>

    <!-- Titre -->
    <h1 class="hero-product__title" data-reveal data-delay="2">
      {{ section.settings.headline | default: '"Propre en <em>30 secondes.</em><br>Parfait à chaque fois."' }}
    </h1>

    <!-- Sous-titre -->
    <p class="hero-product__subtitle" data-reveal data-delay="3">
      {{ section.settings.subtitle | default: 'Le premier nettoyeur de pinceaux électrique USB 3-en-1 : nettoyage profond, séchage automatique et rangement intégré.' }}
    </p>

    <!-- Rating -->
    <div class="hero-product__rating" data-reveal data-delay="3">
      {% render 'star-rating', rating: section.settings.rating_value, size: 'lg' %}
      <span class="rating-text" style="color:rgba(253,250,248,0.9);">{{ section.settings.rating_value | default: '4.9' }}</span>
      <span class="rating-count" style="color:rgba(253,250,248,0.5);">({{ section.settings.review_count | default: '247' }} avis)</span>
    </div>

    <!-- Prix -->
    <div class="hero-product__price-block" data-reveal data-delay="4">
      <span class="price-current">
        {% if current_product.price %}
          {{ current_product.price | money }}
        {% else %}
          24,99 €
        {% endif %}
      </span>
      {% if current_product.compare_at_price > current_product.price %}
        <span class="price-original">{{ current_product.compare_at_price | money }}</span>
        <span class="price-badge">-{{ current_product.compare_at_price | minus: current_product.price | times: 100 | divided_by: current_product.compare_at_price }}%</span>
      {% elsif section.settings.compare_price != blank %}
        <span class="price-original">{{ section.settings.compare_price }}</span>
        <span class="price-badge">-67%</span>
      {% endif %}
    </div>

    <!-- Stock indicator -->
    <div class="stock-indicator" data-reveal data-delay="4" style="margin-bottom:20px;">
      <div class="stock-bar">
        <div class="stock-bar__fill" data-stock-fill="{{ section.settings.stock_percent | default: 22 }}" style="width:0%"></div>
      </div>
      <span class="stock-label">⚡ Seulement {{ section.settings.stock_left | default: 3 }} restants</span>
    </div>

    <!-- ATC principal -->
    <div class="hero-product__atc" data-reveal data-delay="5">
      <button
        class="btn btn--accent btn--full btn--pulse"
        data-atc-btn
        onclick="addToCart('{{ current_product.variants.first.id }}')"
        aria-label="Ajouter au panier — {{ current_product.title }}"
      >
        {{ section.settings.atc_text | default: 'Ajouter au panier →' }}
      </button>

      <div class="trust-badges trust-badges--light" style="justify-content:center;">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'trust_badge' %}
              <div class="trust-badge" style="background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.1);color:rgba(253,250,248,.75);" {{ block.shopify_attributes }}>
                {{ block.settings.icon }} {{ block.settings.text }}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>

    <!-- Trust items -->
    <div class="hero-product__trust" data-reveal data-delay="6">
      <div class="trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        Livraison gratuite
      </div>
      <div class="trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        Retour 30 jours
      </div>
      <div class="trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
        Paiement sécurisé
      </div>
    </div>

  </div>

</section>

{% schema %}
{
  "name": "Hero Produit",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit (optionnel, utilise le produit actuel par défaut)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image hero"
    },
    {
      "type": "text",
      "id": "hero_video",
      "label": "URL vidéo hero (MP4)"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "default": "Offre Lancement — Stock Limité"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Titre principal",
      "default": "Propre en 30 secondes.<br>Parfait à chaque fois."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Le premier nettoyeur de pinceaux électrique USB 3-en-1 : nettoyage profond, séchage automatique et rangement intégré."
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Note (ex: 4.9)",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Nombre d'avis",
      "default": "247"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Prix barré (si pas de variante Shopify)",
      "default": "74,99 €"
    },
    {
      "type": "range",
      "id": "stock_percent",
      "label": "% stock restant (barre visuelle)",
      "min": 5,
      "max": 90,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "stock_left",
      "label": "Nombre d'unités restantes (affiché)",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "atc_text",
      "label": "Texte bouton ATC",
      "default": "Ajouter au panier →"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Badge de confiance",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icône/Emoji",
          "default": "🔒"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Paiement sécurisé"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Produit",
      "blocks": [
        { "type": "trust_badge", "settings": { "icon": "🚚", "text": "Livraison offerte" } },
        { "type": "trust_badge", "settings": { "icon": "↩️", "text": "Retour 30j" } },
        { "type": "trust_badge", "settings": { "icon": "🔒", "text": "100% sécurisé" } }
      ]
    }
  ]
}
{% endschema %}
