<section class="benefits-section" aria-labelledby="benefits-title">
  <div class="container">

    <div class="benefits-section__header" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Pourquoi GlamBrush ?' }}</p>
      <h2 id="benefits-title" class="heading-lg" style="margin-top:12px;">
        {{ section.settings.title | default: 'Conçu pour les passionnées de beauté' }}
      </h2>
      {% if section.settings.subtitle != blank %}
        <p style="color:var(--color-text-muted);margin-top:12px;font-size:var(--text-lg);max-width:560px;margin-inline:auto;">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>

    <div class="benefits-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'benefit' %}
            <div class="benefit-card" data-reveal data-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>

              <div class="benefit-card__icon" aria-hidden="true">
                {% if block.settings.svg_icon != blank %}
                  {{ block.settings.svg_icon }}
                {% else %}
                  <span style="font-size:28px;">{{ block.settings.emoji | default: '✨' }}</span>
                {% endif %}
              </div>

              <h3 class="benefit-card__title">{{ block.settings.title }}</h3>
              <p class="benefit-card__text">{{ block.settings.text }}</p>

              {% if block.settings.highlight != blank %}
                <div style="margin-top:16px;padding:8px 14px;background:var(--color-accent-light);border-radius:var(--radius-pill);display:inline-block;font-size:var(--text-xs);font-weight:700;color:var(--color-accent-strong);">
                  {{ block.settings.highlight }}
                </div>
              {% endif %}

            </div>
        {% endcase %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Bénéfices produit",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Pourquoi GlamBrush ?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre section",
      "default": "Conçu pour les passionnées de beauté"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre (optionnel)"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "default": "⚡"
        },
        {
          "type": "html",
          "id": "svg_icon",
          "label": "SVG icon (optionnel, remplace l'emoji)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Séchage 30 secondes"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "La technologie de centrifugation éjecte l'eau de vos pinceaux en quelques secondes. Fini l'attente !"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Highlight pill (optionnel)",
          "default": "5x plus rapide"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bénéfices produit",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "emoji": "⚡",
            "title": "Séchage 30 secondes",
            "text": "La centrifugation haute vitesse éjecte l'eau instantanément. Vos pinceaux sont prêts à l'emploi immédiatement.",
            "highlight": "5x plus rapide"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "emoji": "🧼",
            "title": "Nettoyage profond",
            "text": "360° de rotation à 2000 tr/min pénètrent jusqu'au cœur des poils pour éliminer pigments et bactéries.",
            "highlight": "Certifié antibactérien"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "emoji": "🔋",
            "title": "USB rechargeable",
            "text": "Batterie longue durée rechargeable via USB-C (inclus). Jusqu'à 200 lavages par charge complète.",
            "highlight": "Sans fil"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "emoji": "💅",
            "title": "Compatible tous pinceaux",
            "text": "8 adaptateurs de tailles différentes pour tous vos pinceaux, de l'eyeliner fin au grand pinceau bronzant.",
            "highlight": "8 adaptateurs inclus"
          }
        }
      ]
    }
  ]
}
{% endschema %}
