<div class="trust-strip">
  <div class="trust-strip__grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'item' %}
          <div class="trust-strip__item" {{ block.shopify_attributes }}>
            <div class="trust-strip__icon" aria-hidden="true">
              {% if block.settings.svg != blank %}
                {{ block.settings.svg }}
              {% else %}
                <span style="font-size:18px;">{{ block.settings.emoji | default: '✓' }}</span>
              {% endif %}
            </div>
            <div class="trust-strip__text">
              <strong>{{ block.settings.title }}</strong>
              {% if block.settings.subtitle != blank %}
                <span>{{ block.settings.subtitle }}</span>
              {% endif %}
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Strip",
  "blocks": [
    {
      "type": "item",
      "name": "Élément de confiance",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "default": "🚚"
        },
        {
          "type": "html",
          "id": "svg",
          "label": "SVG icon (optionnel)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Livraison Express"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sous-titre",
          "default": "3-5 jours"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Strip",
      "blocks": [
        { "type": "item", "settings": { "emoji": "⚡", "title": "Livraison Express", "subtitle": "3-5 jours ouvrés" } },
        { "type": "item", "settings": { "emoji": "🔒", "title": "Paiement Sécurisé", "subtitle": "SSL 256 bits" } },
        { "type": "item", "settings": { "emoji": "↩️", "title": "Retour Gratuit", "subtitle": "30 jours sans tracas" } },
        { "type": "item", "settings": { "emoji": "⭐", "title": "4.9/5 étoiles", "subtitle": "247 avis vérifiés" } }
      ]
    }
  ]
}
{% endschema %}
