<section class="section" aria-labelledby="cart-title">
  <div class="container" style="max-width:760px;">

    <h1 id="cart-title" class="heading-lg" style="text-align:center;margin-bottom:var(--space-lg);">
      Votre panier
    </h1>

    {% if cart.item_count == 0 %}
      <div style="text-align:center;padding:var(--space-lg) 0;">
        <p style="font-size:4rem;margin-bottom:var(--space-sm);">🛒</p>
        <p style="color:var(--color-text-muted);margin-bottom:var(--space-md);">Votre panier est vide.</p>
        <a href="/" class="btn btn--accent">Découvrir le GlamBrush →</a>
      </div>
    {% else %}
      <form action="/cart" method="post" id="cart-form">

        <!-- Cart items -->
        <div style="border:1px solid var(--color-border);border-radius:var(--radius-md);overflow:hidden;margin-bottom:var(--space-md);">
          {% for item in cart.items %}
            <div style="display:flex;gap:16px;padding:20px;{% unless forloop.last %}border-bottom:1px solid var(--color-border);{% endunless %}align-items:center;">
              <a href="{{ item.url }}" style="flex-shrink:0;">
                <img
                  src="{{ item.image | img_url: '120x120', crop: 'center' }}"
                  alt="{{ item.title }}"
                  width="80"
                  height="80"
                  style="border-radius:var(--radius-sm);object-fit:cover;"
                  loading="lazy"
                >
              </a>
              <div style="flex:1;min-width:0;">
                <a href="{{ item.url }}" style="font-weight:600;color:var(--color-primary);font-size:var(--text-sm);">{{ item.product_title }}</a>
                {% unless item.variant_title == 'Default Title' %}
                  <p style="font-size:var(--text-xs);color:var(--color-text-muted);margin-top:4px;">{{ item.variant_title }}</p>
                {% endunless %}
                <p style="font-size:var(--text-sm);color:var(--color-accent-strong);font-weight:700;margin-top:6px;">{{ item.final_line_price | money }}</p>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="display:flex;align-items:center;border:1px solid var(--color-border);border-radius:var(--radius-sm);overflow:hidden;">
                  <button
                    type="button"
                    style="width:36px;height:36px;background:none;border:none;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;"
                    onclick="updateQty({{ item.index }}, {{ item.quantity | minus: 1 }})"
                    aria-label="Diminuer la quantité"
                  >−</button>
                  <span style="width:32px;text-align:center;font-weight:600;font-size:var(--text-sm);">{{ item.quantity }}</span>
                  <button
                    type="button"
                    style="width:36px;height:36px;background:none;border:none;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;"
                    onclick="updateQty({{ item.index }}, {{ item.quantity | plus: 1 }})"
                    aria-label="Augmenter la quantité"
                  >+</button>
                </div>
                <button
                  type="button"
                  onclick="updateQty({{ item.index }}, 0)"
                  style="background:none;border:none;cursor:pointer;color:var(--color-text-muted);padding:8px;"
                  aria-label="Supprimer {{ item.title }}"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"></path></svg>
                </button>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Cart totals -->
        <div style="background:var(--color-bg-alt,#F5F1EE);border-radius:var(--radius-md);padding:24px;margin-bottom:var(--space-md);">
          <div style="display:flex;justify-content:space-between;margin-bottom:12px;">
            <span style="color:var(--color-text-muted);">Sous-total</span>
            <span style="font-weight:600;">{{ cart.total_price | money }}</span>
          </div>
          <div style="display:flex;justify-content:space-between;margin-bottom:16px;">
            <span style="color:var(--color-text-muted);">Livraison</span>
            <span style="color:var(--color-success);font-weight:600;">Gratuite 🎉</span>
          </div>
          <div style="border-top:1px solid var(--color-border);padding-top:16px;display:flex;justify-content:space-between;">
            <span style="font-weight:700;font-size:var(--text-lg);">Total</span>
            <span style="font-weight:700;font-size:var(--text-lg);color:var(--color-accent-strong);">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <!-- CTA -->
        <button
          type="submit"
          name="checkout"
          class="btn btn--accent btn--full btn--lg btn--pulse"
          style="width:100%;"
        >
          Commander — {{ cart.total_price | money }} →
        </button>

        <a href="/" style="display:block;text-align:center;margin-top:16px;font-size:var(--text-sm);color:var(--color-text-muted);">
          ← Continuer mes achats
        </a>

      </form>

      <!-- Trust -->
      <div style="display:flex;gap:20px;justify-content:center;margin-top:var(--space-md);flex-wrap:wrap;">
        <span style="font-size:var(--text-xs);color:var(--color-text-muted);">🔒 Paiement sécurisé</span>
        <span style="font-size:var(--text-xs);color:var(--color-text-muted);">↩️ Retour 30 jours</span>
        <span style="font-size:var(--text-xs);color:var(--color-text-muted);">🚚 Livraison gratuite</span>
      </div>
    {% endif %}

  </div>
</section>

<script>
function updateQty(lineIndex, qty) {
  const body = { updates: {} };
  body.updates[lineIndex] = qty;
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  }).then(() => window.location.reload());
}
</script>

{% schema %}
{
  "name": "Panier",
  "settings": []
}
{% endschema %}
