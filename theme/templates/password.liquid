<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Bientôt disponible</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    body { background: var(--color-bg-dark); color: var(--color-bg); display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .password-page { text-align: center; padding: var(--space-xl); max-width: 500px; }
    .password-page__logo { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: var(--color-accent); margin-bottom: var(--space-lg); }
    .password-page__title { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); margin-bottom: var(--space-md); }
    .password-page__form { display: flex; gap: 12px; margin-top: var(--space-md); }
    .password-page__input { flex: 1; padding: 14px 18px; border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.05); color: white; font-size: var(--text-base); }
    .password-page__input::placeholder { color: rgba(255,255,255,.4); }
  </style>
</head>
<body>
  <div class="password-page">
    <div class="password-page__logo">✨ GlamBrush</div>
    <h1 class="password-page__title">Bientôt disponible</h1>
    <p style="color:rgba(253,250,248,.6);margin-bottom:var(--space-md);">
      Notre boutique ouvre très bientôt. Entrez le mot de passe pour accéder.
    </p>
    {{ form 'storefront_password' }}
      <div class="password-page__form">
        <input
          type="password"
          name="password"
          class="password-page__input"
          placeholder="Mot de passe"
          autocomplete="current-password"
        >
        <button type="submit" class="btn btn--accent">Entrer</button>
      </div>
    {{ endform }}
  </div>
</body>
</html>
